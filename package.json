{
  "name": "my-memo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:local:migrate": "wrangler d1 migrations apply my_memo_d1 --local",
    "db:local:reset": "rm -rf .wrangler/state/v3/d1",
    "db:remote:migrate": "wrangler d1 migrations apply my_memo_d1 --remote",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config=vitest.unit.config.ts",
    "test:integration": "vitest run",
    "test:watch": "vitest --config=vitest.unit.config.ts",
    "test:browser": "vitest run --config=vitest.browser.config.ts",
    "test:e2e": "pnpm run build && playwright test",
    "test:collect": "node scripts/check-test-collection.mjs",
    "test:automation": "node --test scripts/merge-dependabot.test.mjs",
    "test:all": "pnpm run test:collect && pnpm run test:automation && pnpm run test && pnpm run test:browser && pnpm run test:e2e",
    "knip": "knip",
    "actionlint": "actionlint",
    "pinact": "pinact"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@phosphor-icons/core": "2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.6.26",
    "daisyui": "^5.7.16",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.8",
    "honox": "^0.1.61",
    "markdown-it": "^15.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.5.1",
    "@vitest/browser-playwright": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.32.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.132.0"
  },
  "packageManager": "pnpm@11.21.0"
}
