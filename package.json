{
  "name": "my-memo",
  "type": "module",
  "scripts": {
    "dev": "waku dev --port 5173",
    "build": "waku build",
    "preview": "waku start",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:local:migrate": "wrangler d1 migrations apply my_memo_d1 --local",
    "db:local:reset": "rm -rf .wrangler/state/v3/d1",
    "db:remote:migrate": "wrangler d1 migrations apply my_memo_d1 --remote",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config=vitest.unit.config.ts",
    "test:integration": "vitest run",
    "test:watch": "vitest --config=vitest.unit.config.ts",
    "test:browser": "vitest run --config=vitest.browser.config.ts",
    "test:e2e": "pnpm run build && playwright test",
    "test:collect": "node scripts/check-test-collection.mjs",
    "test:automation": "node --test scripts/merge-dependabot.test.mjs",
    "test:all": "pnpm run test:collect && pnpm run test:automation && pnpm run test && pnpm run test:browser && pnpm run test:e2e",
    "knip": "knip",
    "actionlint": "actionlint",
    "pinact": "pinact"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@phosphor-icons/core": "2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.7.7",
    "daisyui": "^5.7.50",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.13",
    "markdown-it": "^15.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "waku": "1.0.0-rc.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^4.1.10",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.41.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@11.21.0"
}
