{
  "name": "my-memo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "ai-config": "mise run --no-cache sync-ai"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.6.25",
    "daisyui": "^5.7.9",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.33",
    "honox": "^0.1.60",
    "marked": "^18.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "wrangler": "^4.117.0"
  }
}
