{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@/*": ["./app/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "types": [
      "vite/client",
      "vitest/importMeta",
      "@types/node",
      "@cloudflare/vitest-plugin/types",
      "./worker-configuration.d.ts"
    ],
    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
