{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/pages/**/*.{ts,tsx}",
    "app/pages.gen.ts",
    "app/style.css",
    "app/routes/**/*.{ts,tsx}",
    "app/**/*.test.{ts,tsx}",
    "app/**/*.integration.test.{ts,tsx}",
    "app/**/*.browser.test.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "vitest*.config.ts",
    "public/theme-init.js",
    "public/pwa-init.js",
    "public/share-receiver.js",
    "waku.config.ts",
    "tests/setup/*.tsx"
  ],
  "project": [
    "app/**/*.{ts,tsx,css}",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs,ts}",
    "public/**/*.js"
  ],
  "ignoreDependencies": ["cloudflare"],
  "ignoreBinaries": ["actionlint", "pinact"],
  "tags": ["-lintignore"]
}
