{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-memo",
  "main": "./dist/index.js",
  "compatibility_date": "2025-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    {
      "pattern": "my-memo.partial.cc",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "d1_databases": [
    {
      "binding": "MY_MEMO_D1",
      "database_name": "my_memo_d1",
      "database_id": "f34065e0-4ea3-437e-b447-a312b9d4cfc3",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "MY_MEMO_FILES",
      "bucket_name": "my-memo-r2"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
}
