{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-memo",
  "main": "./dist/index.js",
  "compatibility_date": "2025-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
  // "vars": {
